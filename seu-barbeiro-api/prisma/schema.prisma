generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  role         String   @default("OWNER")
  barberId     String?
  isActive     Boolean  @default(true)
  passwordHash String
  // Sobe a cada troca de senha ou desativação: tokens antigos deixam de valer.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Barber {
  id             String    @id @default(uuid())
  name           String
  phone          String?
  email          String?   @unique
  avatarUrl      String?
  isActive       Boolean   @default(true)
  commissionRate Decimal?  @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  serviceOverrides   Json @default("{}")
  serviceIds         String[] @default([])
  schedules          WorkSchedule[]
  blocks             ScheduleBlock[]
  appointments       Appointment[]
  commissionPayments CommissionPayment[]
  advances           BarberAdvance[]

  @@map("barbers")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  returnDays  Int?
  processingMin Int @default(0)
  finishingMin Int @default(0)
  resourceId String?
  durationMin Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointmentServices AppointmentService[]

  @@map("services")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  email     String?   @unique
  birthDate DateTime?
  marketingConsent Boolean @default(false)
  technicalRecords TechnicalRecord[]
  waitlist WaitlistEntry[]
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments     Appointment[]
  loyaltyCard      LoyaltyCard?
  notificationLogs NotificationLog[]
  subscriptions    Subscription[]

  @@map("clients")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id         String            @id @default(uuid())
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  commissionRateSnapshot Decimal? @db.Decimal(5, 2)
  loyaltyCredited Boolean @default(false)
  source String @default("DIRECT")
  visitId String?
  returnOfId String?
  discount Decimal @default(0) @db.Decimal(10, 2)
  // Link de autoatendimento do cliente (confirmar, remarcar, cancelar).
  manageToken String? @unique
  // Sinal via Pix: o horário fica reservado até `depositExpiresAt`.
  depositAmount Decimal? @db.Decimal(10, 2)
  depositExpiresAt DateTime?
  depositPaidAt DateTime?
  // Parte da comanda coberta pela assinatura do cliente.
  subscriptionId String?
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionCovered Decimal @default(0) @db.Decimal(10, 2)
  // Pagamento de comissão em que este atendimento foi acertado.
  commissionPaymentId String?
  commissionPayment CommissionPayment? @relation(fields: [commissionPaymentId], references: [id], onDelete: SetNull)
  pixCharges PixCharge[]
  items OrderItem[]
  segments AppointmentSegment[]
  totalPrice Decimal           @db.Decimal(10, 2)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  barber   Barber @relation(fields: [barberId], references: [id])
  barberId String

  services         AppointmentService[]
  payments         Payment[]
  notificationLogs NotificationLog[]

  @@index([startsAt])
  @@index([barberId, startsAt])
  @@index([status])
  @@index([status, startsAt])
  @@index([clientId, startsAt])
  @@index([barberId, commissionPaymentId])
  @@map("appointments")
}

model AppointmentService {
  id               String  @id @default(uuid())
  priceSnapshot    Decimal @db.Decimal(10, 2)
  processingSnapshot Int @default(0)
  finishingSnapshot Int @default(0)
  resourceSnapshot String?
  durationSnapshot Int

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  @@unique([appointmentId, serviceId])
  @@map("appointment_services")
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  SALARY
  EQUIPMENT
  MARKETING
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

model Payment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  notes         String?
  refundedAt    DateTime?
  refundReason  String?
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paidAt])
  @@index([appointmentId])
  @@index([refundedAt])
  @@map("payments")
}

model Expense {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  dueDate     DateTime
  paidAt      DateTime?
  status      ExpenseStatus   @default(PENDING)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([dueDate])
  @@index([status])
  @@index([status, paidAt])
  @@map("expenses")
}

// ─── SETTINGS ────────────────────────────────────────────────────────────────

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── LOYALTY ─────────────────────────────────────────────────────────────────

model LoyaltyCard {
  id             String   @id @default(uuid())
  visitCount     Int      @default(0)
  pointsBalance  Int      @default(0)
  pointsEarned   Int      @default(0)
  pointsRedeemed Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  @@map("loyalty_cards")
}

// ─── COMMISSION PAYMENTS ─────────────────────────────────────────────────────

model CommissionPayment {
  id               String   @id @default(uuid())
  periodFrom       DateTime
  periodTo         DateTime
  totalRevenue     Decimal  @db.Decimal(10, 2)
  commissionAmount Decimal  @db.Decimal(10, 2)
  commissionRate   Decimal  @db.Decimal(5, 2)
  notes            String?
  advancesDeducted Decimal  @default(0) @db.Decimal(10, 2)
  paidAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  barber   Barber @relation(fields: [barberId], references: [id])
  barberId String
  advances BarberAdvance[]
  appointments Appointment[]

  @@index([barberId])
  @@map("commission_payments")
}

// ─── NOTIFICATION LOGS ───────────────────────────────────────────────────────

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLATION
  CUSTOM
}

model NotificationLog {
  id      String             @id @default(uuid())
  type    NotificationType
  phone   String
  message String
  status  NotificationStatus @default(PENDING)
  error   String?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  dedupeKey String? @unique
  lockedAt DateTime?
  sentAt  DateTime?
  createdAt DateTime         @default(now())

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@index([appointmentId])
  @@map("notification_logs")
}

model WorkSchedule {
  id String @id @default(uuid())
  barberId String
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday Int
  openMinute Int
  closeMinute Int
  @@unique([barberId, weekday])
  @@map("work_schedules")
}

model ScheduleBlock {
  id String @id @default(uuid())
  barberId String
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt DateTime
  reason String
  @@index([barberId, startsAt])
  @@map("schedule_blocks")
}

model Resource {
  id String @id @default(uuid())
  name String
  isActive Boolean @default(true)
  @@map("resources")
}

model AppointmentSegment {
  id String @id @default(uuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barberId String
  resourceId String?
  startsAt DateTime
  endsAt DateTime
  kind String
  @@index([barberId, startsAt])
  @@index([resourceId, startsAt])
  @@index([appointmentId])
  @@map("appointment_segments")
}

model TechnicalRecord {
  id String @id @default(uuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  formula String?
  products String?
  preferences String?
  notes String?
  photoUrls String[] @default([])
  photoConsent Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([clientId, createdAt])
  @@map("technical_records")
}

model WaitlistEntry {
  id String @id @default(uuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  barberId String?
  serviceIds String[]
  from DateTime
  to DateTime
  status String @default("WAITING")
  offeredAt DateTime?
  expiresAt DateTime?
  reservedStart DateTime?
  reservedEnd DateTime?
  reservedBarberId String?
  token String? @unique
  appointmentId String? @unique
  createdAt DateTime @default(now())
  @@index([status, from])
  @@map("waitlist_entries")
}

model Outreach {
  id String @id @default(uuid())
  clientId String
  serviceId String
  token String @unique
  notificationId String?
  appointmentId String? @unique
  createdAt DateTime @default(now())
  @@index([clientId, createdAt])
  @@map("outreach")
}

model Product {
  id String @id @default(uuid())
  name String
  price Decimal @db.Decimal(10, 2)
  cost Decimal @db.Decimal(10, 2)
  stock Int @default(0)
  // Abaixo disso o painel avisa para repor (0 = sem aviso).
  minStock Int @default(0)
  isActive Boolean @default(true)
  @@map("products")
}

model OrderItem {
  id String @id @default(uuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  productId String?
  description String
  quantity Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost Decimal @db.Decimal(10, 2)
  @@index([appointmentId])
  @@map("order_items")
}


// ─── VALES (ADIANTAMENTOS) ───────────────────────────────────────────────────

model BarberAdvance {
  id        String   @id @default(uuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  notes     String?
  givenAt   DateTime @default(now())
  createdById String?
  // Pagamento de comissão em que o vale foi descontado.
  settledInId String?
  settledIn   CommissionPayment? @relation(fields: [settledInId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([barberId, settledInId])
  @@map("barber_advances")
}

// ─── CAIXA ───────────────────────────────────────────────────────────────────

model CashSession {
  id             String    @id @default(uuid())
  openedAt       DateTime  @default(now())
  openedById     String
  openingAmount  Decimal   @db.Decimal(10, 2)
  closedAt       DateTime?
  closedById     String?
  expectedAmount Decimal?  @db.Decimal(10, 2)
  countedAmount  Decimal?  @db.Decimal(10, 2)
  notes          String?
  movements      CashMovement[]

  @@index([openedAt])
  @@map("cash_sessions")
}

model CashMovement {
  id          String      @id @default(uuid())
  sessionId   String
  session     CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // SUPPLY = reforço (entra dinheiro); WITHDRAWAL = sangria (sai dinheiro).
  kind        String
  amount      Decimal     @db.Decimal(10, 2)
  reason      String
  createdById String?
  createdAt   DateTime    @default(now())

  @@index([sessionId])
  @@map("cash_movements")
}

// ─── NOTIFICAÇÕES PUSH ───────────────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(uuid())
  adminId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([adminId])
  @@map("push_subscriptions")
}

// ─── ASSINATURAS ─────────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid())
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  serviceIds   String[] @default([])
  // Usos por mês; nulo = ilimitado.
  usesPerCycle Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                 String    @id @default(uuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id])
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id])
  // PENDING (aguarda 1º pagamento), ACTIVE, PAST_DUE, CANCELLED
  status             String    @default("PENDING")
  priceSnapshot      Decimal   @db.Decimal(10, 2)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  charges            SubscriptionCharge[]
  appointments       Appointment[]

  @@index([status, currentPeriodEnd])
  @@index([clientId])
  @@map("subscriptions")
}

model SubscriptionCharge {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  amount         Decimal      @db.Decimal(10, 2)
  // PENDING, PAID, EXPIRED, CANCELLED
  status         String       @default("PENDING")
  paidAt         DateTime?
  paymentId      String?      @unique
  createdAt      DateTime     @default(now())
  pixCharges     PixCharge[]

  @@unique([subscriptionId, periodStart])
  @@map("subscription_charges")
}

// ─── COBRANÇAS PIX (MERCADO PAGO) ────────────────────────────────────────────

model PixCharge {
  id            String    @id @default(uuid())
  // DEPOSIT (sinal do agendamento) ou SUBSCRIPTION (mensalidade)
  kind          String
  // Token da página pública de pagamento.
  token         String    @unique
  providerId    String?   @unique
  amount        Decimal   @db.Decimal(10, 2)
  // PENDING, PAID, EXPIRED, CANCELLED, FAILED
  status        String    @default("PENDING")
  qrCode        String?
  qrCodeBase64  String?
  ticketUrl     String?
  error         String?
  expiresAt     DateTime
  paidAt        DateTime?
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  subscriptionChargeId String?
  subscriptionCharge   SubscriptionCharge? @relation(fields: [subscriptionChargeId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())

  @@index([status, expiresAt])
  @@index([appointmentId])
  @@index([subscriptionChargeId])
  @@map("pix_charges")
}

// ─── REGISTRO DE AÇÕES SENSÍVEIS (LGPD) ──────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  // Quem fez; nulo em ações sem login (ex.: bloqueio de tentativas).
  adminId   String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("audit_logs")
}
