DATABASE_URL="postgresql://user:password@localhost:5432/seu_barbeiro"
JWT_SECRET="sua_chave_secreta_aqui_mude_em_producao"
PORT=3333
NODE_ENV=development

# Um banco por estabelecimento; sem SALON_DATABASES, usa DATABASE_URL.
DEFAULT_SALON=seu-barbeiro
# SALON_DATABASES='{"seu-barbeiro":"postgresql://user:password@localhost:5432/seu_barbeiro","outro-salao":"postgresql://user:password@localhost:5432/outro_salao"}'
FRONTEND_URL=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
SALON_TIMEZONE=America/Sao_Paulo
NOTIFICATION_WORKER=true
# Número de proxies reversos à frente da API (Nginx = 1; 0 sem proxy).
TRUST_PROXY=1

# Backup antes das migrações no deploy (npm run db:backup:all; exige pg_dump).
BACKUP_DIR=/var/backups/seu-barbeiro
BACKUP_KEEP=10

# Provisionamento de um novo salão (npm run db:seed).
SHOP_NAME="Meu salão"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
